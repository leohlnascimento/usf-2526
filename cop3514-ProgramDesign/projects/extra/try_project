i=0
for test_name in ./tests/*.in; do
	i=$((i+1))
	test_name=$(basename "$test_name")
	test_name=${test_name%.*}
	./a.out < "./tests/${test_name}.in" > ./${test_name}.out 
	if [[ $(diff -w ./tests/${test_name}.out ./${test_name}.out) == "" ]]; then
		echo '===================================================='
		echo "Test case #$i *** Correct! ***"
		echo '===================================================='
	else
		echo '===================================================='
		echo "Test case #$i *** Correct! ***"
		echo '===================================================='
		echo 'Difference:'
		diff -w ./tests/${test_name}.out ./${test_name}.out
		echo '===================================================='
	fi
	echo
done
